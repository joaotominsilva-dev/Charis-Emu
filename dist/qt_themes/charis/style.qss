QDialog#QtSoftwareKeyboardDialog QPushButton#button_3:disabled,
QDialog#QtSoftwareKeyboardDialog QPushButton#button_4:disabled,
QDialog#QtSoftwareKeyboardDialog QPushButton#button_5:disabled,
QDialog#QtSoftwareKeyboardDialog QPushButton#button_6:disabled,
QDialog#QtSoftwareKeyboardDialog QPushButton#button_7:disabled,
QDialog#QtSoftwareKeyboardDialog QPushButton#button_8:disabled,
QDialog#QtSoftwareKeyboardDialog QPushButton#button_9:disabled,
QDialog#QtSoftwareKeyboardDialog QPushButton#button_0:disabled,
QDialog#QtSoftwareKeyboardDialog QPushButton#button_return:disabled {
    color: rgba(164, 164, 164, 1);
}

QDialog#QtSoftwareKeyboardDialog QPushButton#button_ok:disabled,
QDialog#QtSoftwareKeyboardDialog QPushButton#button_ok_shift:disabled,
QDialog#QtSoftwareKeyboardDialog QPushButton#button_ok_num:disabled {
    image: url(:/overlay/osk_button_plus_disabled.png);
}

QDialog#QtSoftwareKeyboardDialog QPushButton#button_backspace:disabled,
QDialog#QtSoftwareKeyboardDialog QPushButton#button_backspace_shift:disabled,
QDialog#QtSoftwareKeyboardDialog QPushButton#button_backspace_num:disabled {
    image: url(:/overlay/osk_button_B_disabled.png);
}

QDialog#QtSoftwareKeyboardDialog QPushButton#button_space:disabled,
QDialog#QtSoftwareKeyboardDialog QPushButton#button_space_shift:disabled {
    image: url(:/overlay/osk_button_Y_disabled.png);
}

/*
* SPDX-FileCopyrightText: 2026 Charis
* SPDX-License-Identifier: GPL-3.0-or-later
*
* Charis layout: graphite chrome, cream sheets and cards, Archivo type.
* charcoal #20211C  charcoal2 #2C2D27  cream #F3F4EA  cream2 #E9EADD
* sage #9A9B89  sage-light #C8C9B7  sage-deep #5E604F
* ink #1D1E19  ink-soft #55564B  on-dark-soft #A9AA98  danger #953521
*/

QMainWindow, QDialog, QWizard, QMessageBox, QWidget#centralwidget {
    background-color: #F3F4EA;
    color: #1D1E19;
}

QWidget {
    color: #1D1E19;
    selection-background-color: #20211C;
    selection-color: #F3F4EA;
}

QWidget:disabled {
    color: #9A9B89;
}

/* ---------- Top bar and header ---------- */

QMenuBar {
    background-color: #20211C;
    color: #F3F4EA;
    padding: 6px 16px 0px 16px;
    border: none;
    font-weight: 600;
}

QMenuBar::item {
    background: transparent;
    color: #A9AA98;
    padding: 6px 12px;
    border-radius: 10px;
}

QMenuBar::item:selected, QMenuBar::item:pressed {
    background-color: #2C2D27;
    color: #F3F4EA;
}

QWidget#CharisHeader {
    background-color: #20211C;
}

QLabel#CharisBrand {
    color: #F3F4EA;
    font-size: 18px;
    font-weight: 700;
}

QLabel#CharisGreeting {
    color: #F3F4EA;
    font-size: 34px;
    font-weight: 800;
}

QLabel#CharisPill {
    background-color: #2C2D27;
    color: #A9AA98;
    border-radius: 14px;
    padding: 6px 14px;
    font-size: 13px;
}

QLabel#CharisClock {
    color: #A9AA98;
    font-size: 13px;
}

QWidget#CharisSheetEdge {
    background-color: #F3F4EA;
    border-top-left-radius: 22px;
    border-top-right-radius: 22px;
}

QFrame#CharisSheetHandle {
    background-color: #C8C9B7;
    border-radius: 2px;
}

/* ---------- Menus ---------- */

QMenu {
    background-color: #F3F4EA;
    color: #1D1E19;
    border: 1px solid #C8C9B7;
    border-radius: 14px;
    padding: 8px;
}

QMenu::item {
    padding: 8px 28px 8px 14px;
    border-radius: 10px;
    background: transparent;
}

QMenu::item:selected {
    background-color: #20211C;
    color: #F3F4EA;
}

QMenu::item:disabled {
    color: #9A9B89;
}

QMenu::separator {
    height: 1px;
    background: #C8C9B7;
    margin: 6px 8px;
}

QMenu::icon {
    padding-left: 8px;
}

/* ---------- Game list ---------- */

QTreeView, QListView, QTableView, QTableWidget, QTreeWidget, QListWidget {
    background-color: #F3F4EA;
    alternate-background-color: #E9EADD;
    color: #1D1E19;
    border: none;
    outline: 0;
    font-size: 14px;
}

QTreeView::item, QTableView::item, QTreeWidget::item {
    padding: 6px 4px;
    border: none;
}

QTreeView::item:hover, QTreeWidget::item:hover, QListView::item:hover {
    background-color: #E9EADD;
}

QTreeView::item:selected, QTreeWidget::item:selected, QTableView::item:selected,
QListView::item:selected, QListWidget::item:selected {
    background-color: #20211C;
    color: #F3F4EA;
}

QListView::item {
    border-radius: 18px;
    padding: 10px;
    margin: 6px;
}

QHeaderView {
    background-color: #F3F4EA;
    border: none;
}

QHeaderView::section {
    background-color: #F3F4EA;
    color: #55564B;
    border: none;
    border-bottom: 1px solid #C8C9B7;
    padding: 10px 8px;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
}

QHeaderView::section:hover {
    color: #1D1E19;
}

/* ---------- Buttons ---------- */

QPushButton, QToolButton {
    background-color: #20211C;
    color: #F3F4EA;
    border: none;
    border-radius: 14px;
    padding: 9px 20px;
    font-weight: 700;
}

QPushButton:hover, QToolButton:hover {
    background-color: #2C2D27;
}

QPushButton:pressed, QToolButton:pressed, QPushButton:checked, QToolButton:checked {
    background-color: #5E604F;
}

QPushButton:disabled, QToolButton:disabled {
    background-color: #C8C9B7;
    color: #F3F4EA;
}

QPushButton:default {
    background-color: #20211C;
}

QDialogButtonBox QPushButton {
    min-width: 96px;
}

QToolButton {
    padding: 6px 10px;
}

/* ---------- Fields ---------- */

QLineEdit, QTextEdit, QPlainTextEdit, QAbstractSpinBox, QComboBox, QKeySequenceEdit {
    background-color: #E9EADD;
    color: #1D1E19;
    border: 1px solid transparent;
    border-radius: 12px;
    padding: 7px 12px;
    selection-background-color: #20211C;
    selection-color: #F3F4EA;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QAbstractSpinBox:focus, QComboBox:focus {
    border: 1px solid #5E604F;
    background-color: #F3F4EA;
}

QComboBox::drop-down {
    border: none;
    width: 26px;
}

QComboBox QAbstractItemView {
    background-color: #F3F4EA;
    border: 1px solid #C8C9B7;
    border-radius: 12px;
    padding: 6px;
    selection-background-color: #20211C;
    selection-color: #F3F4EA;
}

QAbstractSpinBox::up-button, QAbstractSpinBox::down-button {
    border: none;
    width: 18px;
}

/* ---------- Cards, tabs and groups ---------- */

QGroupBox {
    background-color: #E9EADD;
    border: none;
    border-radius: 18px;
    margin-top: 26px;
    padding: 18px 14px 14px 14px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 6px;
    padding: 0px 6px 4px 6px;
    color: #55564B;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
}

QTabWidget::pane {
    background-color: #F3F4EA;
    border: none;
    border-top: 1px solid #C8C9B7;
}

QTabBar::tab {
    background-color: transparent;
    color: #55564B;
    border-radius: 14px;
    padding: 7px 16px;
    margin: 4px 4px 8px 0px;
    font-weight: 700;
}

QTabBar::tab:hover {
    background-color: #E9EADD;
    color: #1D1E19;
}

QTabBar::tab:selected {
    background-color: #20211C;
    color: #F3F4EA;
}

QListWidget#selectorList {
    background-color: #E9EADD;
    border-radius: 18px;
    padding: 8px;
}

QListWidget#selectorList::item {
    padding: 9px 12px;
    border-radius: 12px;
}

/* ---------- Toggles ---------- */

QCheckBox, QRadioButton {
    spacing: 10px;
    background: transparent;
}

QCheckBox::indicator, QRadioButton::indicator, QGroupBox::indicator {
    width: 18px;
    height: 18px;
    border: 2px solid #9A9B89;
    background-color: #F3F4EA;
}

QCheckBox::indicator, QGroupBox::indicator {
    border-radius: 6px;
}

QRadioButton::indicator {
    border-radius: 11px;
}

QCheckBox::indicator:hover, QRadioButton::indicator:hover {
    border-color: #5E604F;
}

QCheckBox::indicator:checked, QRadioButton::indicator:checked, QGroupBox::indicator:checked {
    background-color: #20211C;
    border-color: #20211C;
}

QCheckBox::indicator:indeterminate {
    background-color: #9A9B89;
    border-color: #9A9B89;
}

/* ---------- Sliders, progress, scrollbars ---------- */

QSlider::groove:horizontal {
    height: 6px;
    background: #C8C9B7;
    border-radius: 3px;
}

QSlider::sub-page:horizontal {
    background: #20211C;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    background: #F3F4EA;
    border: 2px solid #20211C;
    width: 16px;
    height: 16px;
    margin: -7px 0;
    border-radius: 10px;
}

QProgressBar {
    background-color: #C8C9B7;
    border: none;
    border-radius: 8px;
    color: #1D1E19;
    text-align: center;
    min-height: 16px;
}

QProgressBar::chunk {
    background-color: #20211C;
    border-radius: 8px;
}

QScrollBar:vertical {
    background: transparent;
    width: 12px;
    margin: 4px 2px;
}

QScrollBar:horizontal {
    background: transparent;
    height: 12px;
    margin: 2px 4px;
}

QScrollBar::handle:vertical, QScrollBar::handle:horizontal {
    background: #C8C9B7;
    border-radius: 4px;
    min-height: 32px;
    min-width: 32px;
}

QScrollBar::handle:vertical:hover, QScrollBar::handle:horizontal:hover {
    background: #9A9B89;
}

QScrollBar::add-line, QScrollBar::sub-line {
    width: 0px;
    height: 0px;
}

QScrollBar::add-page, QScrollBar::sub-page {
    background: transparent;
}

/* ---------- Status bar and tooltips ---------- */

QStatusBar {
    background-color: #20211C;
    color: #A9AA98;
    border: none;
    padding: 2px 10px;
}

QStatusBar QLabel {
    color: #A9AA98;
    background: transparent;
}

QStatusBar QPushButton {
    border-radius: 10px;
    padding: 2px 8px;
    font-weight: 600;
}

QPushButton#TogglableStatusBarButton,
QPushButton#RendererStatusBarButton,
QPushButton#RefreshButton,
QPushButton#GPUStatusBarButton,
QPushButton#DockingStatusBarButton {
    background-color: transparent;
    color: #A9AA98;
    border: 1px solid transparent;
}

QPushButton#TogglableStatusBarButton:hover,
QPushButton#RendererStatusBarButton:hover,
QPushButton#RefreshButton:hover,
QPushButton#GPUStatusBarButton:hover,
QPushButton#DockingStatusBarButton:hover {
    background-color: #2C2D27;
    border: 1px solid transparent;
}

QPushButton#TogglableStatusBarButton:checked {
    color: #F3F4EA;
}

QPushButton#RendererStatusBarButton:checked,
QPushButton#GPUStatusBarButton:checked {
    color: #C8C9B7;
}

QPushButton#RendererStatusBarButton:!checked,
QPushButton#GPUStatusBarButton:!checked {
    color: #F3F4EA;
}

QToolTip {
    background-color: #20211C;
    color: #F3F4EA;
    border: none;
    border-radius: 10px;
    padding: 6px 10px;
}

QLabel[accessibleName="danger"] {
    color: #953521;
}

QGroupBox QLineEdit, QGroupBox QAbstractSpinBox, QGroupBox QComboBox, QGroupBox QKeySequenceEdit,
QGroupBox QTextEdit, QGroupBox QPlainTextEdit {
    background-color: #F3F4EA;
}

QGroupBox QLineEdit:focus, QGroupBox QAbstractSpinBox:focus, QGroupBox QComboBox:focus {
    background-color: #FFFFFF;
}

QPushButton#CharisPillButton {
    background-color: #2C2D27;
    color: #C8C9B7;
    border-radius: 12px;
    padding: 6px 14px;
    font-size: 13px;
    font-weight: 600;
}

QPushButton#CharisPillButton:hover {
    background-color: #3A3B34;
    color: #F3F4EA;
}

QPushButton#CharisPillButton:checked {
    background-color: #F3F4EA;
    color: #1D1E19;
}

QPushButton#CharisPillButton:disabled {
    background-color: #2C2D27;
    color: #5E604F;
}

QDialog#GameClockDialog QLabel#DialogEyebrow {
    color: #55564B;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2px;
}

QDialog#GameClockDialog QLabel#DialogTitle {
    color: #1D1E19;
    font-size: 26px;
    font-weight: 800;
}

QDialog#GameClockDialog QLabel#DialogText {
    color: #55564B;
    font-size: 14px;
}

QDialog#GameClockDialog QLabel#DialogPreview {
    background-color: #20211C;
    color: #F3F4EA;
    border-radius: 16px;
    padding: 14px 18px;
    font-size: 15px;
    font-weight: 700;
}

QDialog#GameClockDialog QLabel#DialogNote {
    color: #953521;
    font-size: 13px;
}

QDialog#GameClockDialog QRadioButton {
    background-color: #E9EADD;
    border-radius: 16px;
    padding: 14px 16px;
    font-size: 15px;
    font-weight: 700;
}

QDialog#GameClockDialog QRadioButton:checked {
    background-color: #DEDFD1;
}

QDialog#GameClockDialog QDateTimeEdit {
    font-size: 16px;
    font-weight: 700;
    padding: 10px 14px;
}

QDialog#GameClockDialog QPushButton#QuickButton {
    background-color: #E9EADD;
    color: #1D1E19;
    padding: 7px 14px;
    border-radius: 12px;
    font-weight: 700;
}

QDialog#GameClockDialog QPushButton#QuickButton:hover {
    background-color: #DEDFD1;
}

QDialog#GameClockDialog QPushButton#SecondaryButton {
    background-color: #E9EADD;
    color: #1D1E19;
}

QCalendarWidget QWidget {
    alternate-background-color: #E9EADD;
}

QCalendarWidget QToolButton {
    background-color: transparent;
    color: #1D1E19;
    padding: 4px 8px;
}

QCalendarWidget QAbstractItemView:enabled {
    background-color: #F3F4EA;
    color: #1D1E19;
    selection-background-color: #20211C;
    selection-color: #F3F4EA;
}

QDateTimeEdit::drop-down {
    border: none;
    width: 28px;
}

QStatusBar::item {
    border: none;
}

QFrame#CharisContinue {
    background-color: #E9EADD;
    border-radius: 20px;
}

QLabel#ContinueEyebrow {
    color: #55564B;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2px;
}

QLabel#ContinueTitle {
    color: #1D1E19;
    font-size: 20px;
    font-weight: 800;
}

QLabel#ContinueDetail {
    color: #55564B;
    font-size: 13px;
}

QPushButton#ContinuePlay {
    background-color: #20211C;
    color: #F3F4EA;
    border-radius: 14px;
    padding: 12px 26px;
    font-size: 15px;
    font-weight: 700;
}

QPushButton#ContinuePlay:hover {
    background-color: #2C2D27;
}

QPushButton#CharisUpdateButton {
    background-color: #F3F4EA;
    color: #1D1E19;
    border-radius: 12px;
    padding: 6px 14px;
    font-size: 13px;
    font-weight: 700;
}

QPushButton#CharisUpdateButton:hover {
    background-color: #FFFFFF;
}

QDialog#CharisUpdateDialog QLabel#DialogEyebrow {
    color: #55564B;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2px;
}

QDialog#CharisUpdateDialog QLabel#DialogTitle {
    color: #1D1E19;
    font-size: 26px;
    font-weight: 800;
}

QDialog#CharisUpdateDialog QLabel#DialogText {
    color: #55564B;
    font-size: 14px;
}

QDialog#CharisUpdateDialog QLabel#DialogPreview {
    background-color: #20211C;
    color: #F3F4EA;
    border-radius: 16px;
    padding: 14px 18px;
    font-size: 14px;
    font-weight: 700;
}

QDialog#CharisUpdateDialog QLabel#DialogPreview[error="true"] {
    background-color: #953521;
}

QDialog#CharisUpdateDialog QPushButton#SecondaryButton {
    background-color: #E9EADD;
    color: #1D1E19;
}
